#!/usr/bin/env python3
"""Stand-in for rpicam-still in tests: writes one JPEG test image to the -o path."""
import json
import os
import subprocess
import sys

args = sys.argv[1:]

log_path = os.environ.get('FAKE_CAMERA_LOG')
if log_path:
    with open(log_path, 'a') as log:
        log.write(json.dumps(['rpicam-still'] + args) + '\n')


def option(name, default):
    return args[args.index(name) + 1] if name in args else default


output = option('-o', None)
if not output:
    sys.exit('fake rpicam-still: no -o path given')

sys.exit(subprocess.call([
    'ffmpeg', '-hide_banner', '-loglevel', 'error', '-y',
    '-f', 'lavfi', '-i', f"testsrc2=size={option('--width', '640')}x{option('--height', '480')}",
    '-frames:v', '1', output,
]))
